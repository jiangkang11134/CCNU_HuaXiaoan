# Yuxi deployment environment template
#
# 这里只保留服务启动前必须存在的部署级配置。
# 模型供应商 Key、OCR Key、URL 白名单、Tavily 搜索 Key、默认模型等运行时业务配置，
# 请在登录后台后进入「基本设置」或「模型供应商」中维护。

# Runtime mode and auth secrets
YUXI_ENV=development
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=

# Production persistent data directory.
# Keep this outside the code directory in production to avoid data loss when recloning code.
YUXI_DATA_DIR=

# Browser CORS origins, comma-separated.
# Same-origin Nginx deployment can keep this empty.
# Cross-origin deployment example: https://your-frontend.example.com
YUXI_CORS_ORIGINS=

# Initial built-in super admin, only used by initialization logic when needed.
YUXI_SUPER_ADMIN_NAME=
YUXI_SUPER_ADMIN_PASSWORD=

# Public host/IP used when containers need to generate externally reachable URLs.
HOST_IP=

# MinerU official API base URL. API Key is configured in the admin UI.
MINERU_API_URI=https://mineru.net/api/v4

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yuxi
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/yuxi

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO object storage
MINIO_URI=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Milvus vector database
MILVUS_URI=http://milvus:19530
MILVUS_DB_NAME=default
MILVUS_TOKEN=

# Neo4j graph database
NEO4J_URI=bolt://graph:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=0123456789

# Sandbox provisioner infrastructure
SANDBOX_PROVIDER=provisioner
SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
SANDBOX_PROVISIONER_BACKEND=docker
SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:latest
SANDBOX_CONTAINER_PORT=8080
SANDBOX_HEALTH_TIMEOUT_SECONDS=300
SANDBOX_IDLE_TIMEOUT_SECONDS=120
SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
SANDBOX_DOCKER_NETWORK=yuxi-know_app-network
SANDBOX_DOCKER_THREADS_HOST_PATH=
SANDBOX_DOCKER_SANDBOX_PREFIX=yuxi-sandbox
SANDBOX_DOCKER_SANDBOX_HOST=host.docker.internal

# Optional proxy for sandbox containers
SANDBOX_HTTP_PROXY=
SANDBOX_HTTPS_PROXY=

# Kubernetes sandbox backend, only used when SANDBOX_PROVISIONER_BACKEND=kubernetes
SANDBOX_K8S_NAMESPACE=yuxi-know
SANDBOX_NODE_HOST=host.docker.internal
KUBECONFIG_PATH=/root/.kube/config
THREAD_PVC=yuxi-thread
SKILLS_PVC=yuxi-skills
